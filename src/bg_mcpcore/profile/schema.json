{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bauer-group/LIB-BG-MCPCore/main/src/bg_mcpcore/profile/schema.json",
  "$defs": {
    "AccessControlConfig": {
      "additionalProperties": false,
      "description": "Declares a coarse role/claim access gate on every authenticated request.\n\nPresence of this block activates the gate; the allowlist + audit toggle come\nfrom settings (``MCP_ALLOWED_ROLES`` / ``MCP_ROLE_CHECK_AUDIT_ONLY``, env-\ntunable per deployment). ``roles_claim`` names the token claim carrying the\nuser's roles (list of strings, or of ``{\"name\": ...}`` objects). When the\nclaim is absent (e.g. an IdP that carries no roles), the gate passes \u2014\nenforcement is deferred to the upstream \u2014 so it is a no-op in modes that\ndon't supply roles.",
      "properties": {
        "roles_claim": {
          "default": "roles",
          "title": "Roles Claim",
          "type": "string"
        }
      },
      "title": "AccessControlConfig",
      "type": "object"
    },
    "AuthConfig": {
      "additionalProperties": false,
      "properties": {
        "inbound": {
          "$ref": "#/$defs/InboundAuthConfig"
        },
        "outbound": {
          "$ref": "#/$defs/OutboundAuthConfig"
        }
      },
      "title": "AuthConfig",
      "type": "object"
    },
    "BackendConfig": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "api_base_path": {
          "default": "",
          "title": "Api Base Path",
          "type": "string"
        },
        "http_timeout": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "title": "Http Timeout",
          "type": "integer"
        },
        "verify_tls": {
          "default": true,
          "title": "Verify Tls",
          "type": "boolean"
        },
        "user_agent": {
          "default": "bg-mcpcore",
          "title": "User Agent",
          "type": "string"
        }
      },
      "required": [
        "base_url"
      ],
      "title": "BackendConfig",
      "type": "object"
    },
    "CacheConfig": {
      "additionalProperties": false,
      "description": "Response-freshness hints for cacheable results (FastMCP 4, SEP-2549).\n\nA caching client may reuse a result for ``ttl`` seconds instead of making\nanother round trip. FastMCP applies the hint to the results the protocol\ntreats as cacheable \u2014 ``tools/list``, ``prompts/list``, ``resources/list``,\n``resources/templates/list``, ``server/discover`` and ``resources/read``.\nTool CALLS are never cached, so a tool always executes.\n\nThat makes this worth setting on a server whose catalogue is stable and\nwhose clients re-list often, and on config-driven resources, whose reads go\nthrough ``resources/read``.\n\nThis is a HINT, not an authorization boundary: it says how stale an answer\nmay be, never who may read it. ``scope`` decides whether a SHARED cache (a\nproxy, a fleet-wide store) may hold the entry \u2014 keep the ``\"private\"``\ndefault for anything that varies by the caller's identity or permissions,\nso one user's result can never be served to another. Use ``\"public\"`` only\nfor responses identical for every caller, such as a read-only catalogue.",
      "properties": {
        "ttl": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Ttl",
          "type": "integer"
        },
        "scope": {
          "default": "private",
          "enum": [
            "public",
            "private"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "ttl"
      ],
      "title": "CacheConfig",
      "type": "object"
    },
    "ExtensionsRef": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "source"
      ],
      "title": "ExtensionsRef",
      "type": "object"
    },
    "InboundAuthConfig": {
      "additionalProperties": true,
      "properties": {
        "mode": {
          "default": "none",
          "title": "Mode",
          "type": "string"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "title": "InboundAuthConfig",
      "type": "object"
    },
    "OutboundAuthConfig": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "default": "none",
          "title": "Type",
          "type": "string"
        },
        "header": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header"
        },
        "value_from_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value From Env"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "resolver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        }
      },
      "title": "OutboundAuthConfig",
      "type": "object"
    },
    "RoutesConfig": {
      "additionalProperties": false,
      "properties": {
        "healthz": {
          "default": true,
          "title": "Healthz",
          "type": "boolean"
        },
        "logo": {
          "default": true,
          "title": "Logo",
          "type": "boolean"
        },
        "index": {
          "default": true,
          "title": "Index",
          "type": "boolean"
        }
      },
      "title": "RoutesConfig",
      "type": "object"
    },
    "ToolsConfig": {
      "additionalProperties": true,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "register": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Register"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "title": "Include",
          "type": "array"
        }
      },
      "required": [
        "source"
      ],
      "title": "ToolsConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "instructions": {
      "default": "",
      "title": "Instructions",
      "type": "string"
    },
    "icon_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Icon Url"
    },
    "website_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Website Url"
    },
    "backend": {
      "anyOf": [
        {
          "$ref": "#/$defs/BackendConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "auth": {
      "$ref": "#/$defs/AuthConfig"
    },
    "tools": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolsConfig"
        },
        {
          "items": {
            "$ref": "#/$defs/ToolsConfig"
          },
          "type": "array"
        }
      ],
      "title": "Tools"
    },
    "routes": {
      "$ref": "#/$defs/RoutesConfig"
    },
    "extensions": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionsRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "access_control": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccessControlConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cache": {
      "anyOf": [
        {
          "$ref": "#/$defs/CacheConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "display_name",
    "tools"
  ],
  "title": "Profile",
  "type": "object"
}
